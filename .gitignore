# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local verification screenshots
*.png
shot-*.png
tsconfig.tsbuildinfo
# ...but the brand icon set must be tracked
!app/icon.png
!app/apple-icon.png

# Claude Design handoff bundle + local screenshot artifacts (reference only)
/design/

# Page-audit output (regenerated by `npm run audit:pages`)
audit-report.json
design-review/lighthouse/*.json

# Design-review screenshots: full-page captures run to ~19 MB each. The
# viewport-sized shots are committed as the visual record; regenerate the rest
# locally with `node scripts/review-shots.mjs --label <name>`.
design-review/**/*-full-*.png
