# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local verification screenshots
*.png
shot-*.png
tsconfig.tsbuildinfo
# ...but the brand icon set must be tracked. This negation is load-bearing:
# renaming icon.png -> icon1.png without updating it meant the new logo was
# silently dropped from a commit and the JSON-LD pointed at a 404 in
# production. If an icon file is renamed, this list must move with it.
!app/icon1.png
!app/apple-icon.png
!public/icon-192.png
!public/icon-512.png

# Claude Design handoff bundle + local screenshot artifacts (reference only)
/design/

# Page-audit output (regenerated by `npm run audit:pages`)
audit-report.json
design-review/lighthouse/*.json

# Design-review screenshots ARE the committed visual record — downscaled to 1x
# before committing (the global *.png above would otherwise silently eat every
# `git add -A`, which is exactly what happened for the mission's first eleven
# commits: zero screenshots reached the repo while the docs claimed an archive).
# Order matters: this negation must follow *.png, and the full-page exclusion
# must follow the negation.
!design-review/**/*.png
design-review/**/*-full-*.png
# Full-size social sample renders regenerate from scripts/social-samples.mjs;
# only the contact sheets are the committed review record.
design-review/16-social/samples/

# Audit caches (regenerated by scripts/audit-links.mjs)
/.cache/
